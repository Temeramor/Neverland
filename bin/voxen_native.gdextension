[configuration]
entry_symbol = "voxen_native_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/linux/libvoxen_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libvoxen_native.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/windows/voxen_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/voxen_native.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://bin/android/libvoxen_native.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libvoxen_native.android.template_release.arm64.so"

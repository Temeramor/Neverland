; Engine configuration file.
; SeedTerrain project layout for Godot 4.7.2.
config_version=5

[application]
config/name="Neverland"
config/description="Neverland 0.1.0.6 — hierarchical world-wide voxel LOD with real voxel shadows."
config/version="0.1.0.6"
config/icon="res://icon.svg"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]
GameSettings="*res://scripts/systems/game_settings.gd"

[display]
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering/shading/overrides/force_vertex_shading.mobile=false
textures/default_filters/use_nearest_mipmap_filter=false

[input_devices]
pointing/emulate_mouse_from_touch=true
